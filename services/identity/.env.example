ENV=dev
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/identity
REDIS_URL=redis://localhost:6379/0
# Shared team secret: the SAME value in messaging, money and identity
INTERNAL_API_KEY=change-me
MONEY_URL=http://localhost:8002

# Public pages + passkeys. On your laptop localhost works without HTTPS.
# With ngrok: PUBLIC_BASE_URL=https://<id>.ngrok-free.app and RP_ID=<id>.ngrok-free.app
PUBLIC_BASE_URL=http://localhost:8003
RP_ID=localhost
RP_NAME=Student Money Agent

# Three DIFFERENT Fernet keys. Make each with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=change-me
VAULT_MASTER_KEY=change-me
SESSION_SECRET=change-me

# Documents: local (dev only, folder vault_local/) or s3 (Cloudflare R2 in production)
STORAGE_BACKEND=local
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# true = the api also runs the background jobs (small hosting plans, see DEPLOY.md).
# Keep false when you run the jobs as their own process.
RUN_JOBS_IN_API=false
