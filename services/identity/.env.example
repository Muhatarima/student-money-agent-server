# Identity service environment variables
# Copy this to .env and fill in real values. Never commit .env.

# ── Database ──────────────────────────────────────────────────────────────────
# Local: postgresql+asyncpg://app:app@localhost:5432/identity
# Railway: use the postgresql+asyncpg:// form of the Postgres plugin URL
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/identity

# ── Redis ─────────────────────────────────────────────────────────────────────
# Local: redis://localhost:6379/0
# Upstash: rediss://<...>  (must use protocol=2)
REDIS_URL=redis://localhost:6379/0

# ── Shared secrets (same value in messaging, money, and identity) ─────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_API_KEY=changeme

# PHONE_HASH_KEY is shared between A (messaging) and C (identity).
# ONE person on the team generates it; share it privately (password manager).
# python -c "import secrets; print(secrets.token_hex(32))"
PHONE_HASH_KEY=changeme

# ── Service URLs ──────────────────────────────────────────────────────────────
MONEY_URL=http://localhost:8002

# ── WebAuthn / Passkeys ───────────────────────────────────────────────────────
# PUBLIC_BASE_URL is exactly what the browser sees (scheme + host + port).
# For local dev: http://localhost:8003
# For ngrok testing: https://<your-subdomain>.ngrok-free.app
# For production: https://<your-railway-domain>
PUBLIC_BASE_URL=http://localhost:8003
RP_ID=localhost
RP_NAME=Student Money Agent

# ── Encryption keys ───────────────────────────────────────────────────────────
# Generate both with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=changeme
VAULT_MASTER_KEY=changeme

# ── Session ───────────────────────────────────────────────────────────────────
# python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=changeme

# ── Document storage backend ──────────────────────────────────────────────────
# "local" for dev (files in vault_local/), "s3" for production (Cloudflare R2)
STORAGE_BACKEND=local
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── Environment ───────────────────────────────────────────────────────────────
# "dev" or "production"
# In production: refuses to start if PUBLIC_BASE_URL is not https.
ENV=dev
