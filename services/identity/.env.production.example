# Identity Service - Production Environment Template (Railway)
# DO NOT COMMIT REAL SECRETS. Set these in Railway's Service Variables.

# ── Database (Railway Postgres plugin reference variable) ─────────────────────
# Format: postgresql+asyncpg://postgres:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
DATABASE_URL=postgresql+asyncpg://postgres:password@postgres.railway.internal:5432/identity

# ── Redis (Railway Redis plugin reference variable) ───────────────────────────
REDIS_URL=redis://default:password@redis.railway.internal:6379

# ── Shared Internal Secrets (Generate 32-byte hex for each) ───────────────────
# python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_API_KEY=replace_with_32_byte_hex_shared_across_all_services
PHONE_HASH_KEY=replace_with_32_byte_hex_shared_with_messaging

# ── Private Service URLs (Internal Railway DNS) ──────────────────────────────
MONEY_URL=http://money-api.railway.internal:8002

# ── WebAuthn / Passkeys (Public HTTPS Domain) ─────────────────────────────────
# PUBLIC_BASE_URL must match the public domain assigned by Railway or Custom Domain
PUBLIC_BASE_URL=https://identity.yourdomain.up.railway.app
RP_ID=identity.yourdomain.up.railway.app
RP_NAME=Student Money Agent

# ── Symmetric Encryption Keys (Fernet keys) ───────────────────────────────────
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=replace_with_base64_fernet_key
VAULT_MASTER_KEY=replace_with_base64_fernet_key

# ── Session Cookie Signing Secret ─────────────────────────────────────────────
# python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=replace_with_32_byte_hex

# ── Storage Backend: Cloudflare R2 (Private S3-compatible bucket) ─────────────
STORAGE_BACKEND=s3
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=student-vault-production
S3_ACCESS_KEY=replace_with_r2_access_key
S3_SECRET_KEY=replace_with_r2_secret_key

# ── Environment Mode ──────────────────────────────────────────────────────────
# "production" enforces: HTTPS on PUBLIC_BASE_URL, HSTS headers, secure cookies
ENV=production
