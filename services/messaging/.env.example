WA_VERIFY_TOKEN=change-me
WA_APP_SECRET=change-me
REDIS_URL=rediss://default:PASSWORD@HOST.upstash.io:6379
# Shared team secret (same value everyone uses), see MANUAL_TODO.md
PHONE_HASH_KEY=change-me

# Other services. Shared team secret for INTERNAL_API_KEY, see MANUAL_TODO.md
INTERNAL_API_KEY=change-me
MONEY_URL=http://localhost:8002
IDENTITY_URL=http://localhost:8003

# Sending replies. Keep WA_FAKE_SEND=true until you have a real Meta token (see MANUAL_TODO.md)
WA_FAKE_SEND=true
# Optional: in fake mode also POST each message to mock_server.py (uvicorn mock_server:app --port 8009)
WA_FAKE_SEND_URL=
WA_ACCESS_TOKEN=change-me
WA_PHONE_NUMBER_ID=change-me
WA_API_VERSION=v21.0

# AI agent: gemini (default) or anthropic. Leave the chosen provider's key empty to run
# without AI (users get the button menu)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# true = the api also runs the background jobs (small hosting plans, see DEPLOY.md).
# Keep false when you run the jobs as their own process.
RUN_JOBS_IN_API=false
